.answer-image-canvas{position:fixed;left:-2000px;top:0;width:375px;height:500px;pointer-events:none;}
.image-share-backdrop{position:fixed;inset:0;z-index:50;background:rgba(31,45,69,.3);display:flex;align-items:flex-end;}
.image-share-panel{width:100%;max-height:93%;padding:34rpx 34rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:36rpx 36rpx 0 0;background:#f8fafc;animation:motion-sheet-in .3s cubic-bezier(.22,1,.36,1) both;}
