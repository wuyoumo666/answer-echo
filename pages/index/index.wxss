.listen-button[disabled]{box-shadow:none;}
.home-footer{font-size:21rpx;color:#929eae;letter-spacing:.3rpx;height:66rpx;}
.home.is-typing .hero{min-height:270rpx;padding-top:20rpx;padding-bottom:30rpx;}
.home.is-typing .color-orbit{display:none;}
.home.is-typing .hero-eyebrow{display:none;}
.home.is-typing .hero-title{font-size:43rpx;}
.home.is-typing .hero-description{font-size:24rpx;margin-top:14rpx;}
.scene{animation:scene-enter .32s cubic-bezier(.22,1,.36,1) both;transition:opacity .14s ease,transform .14s ease;}
.scene.scene-leaving{animation:none;opacity:0;transform:translateY(-10rpx);pointer-events:none;}
.scene.scene-back.scene-leaving{transform:translateY(10rpx);}
@keyframes scene-enter{from{opacity:0;transform:translateY(18rpx);}to{opacity:1;transform:translateY(0);}}
.answer-page,.journal-page,.answer-text,.answer-reflection{animation:none;}
.page-content{padding:34rpx 42rpx calc(36rpx + env(safe-area-inset-bottom));}
.edition-row{font-size:22rpx;}
.date-label{font-size:20rpx;color:#8f9aab;}
