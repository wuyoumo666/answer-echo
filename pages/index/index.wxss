@import "../../styles/adaptive.wxss";
@import "../../styles/letter-flight.wxss";
.app-shell{height:100%;display:flex;flex-direction:column;background:#fff;position:relative;overflow:hidden;}
.status-space,.navigation{flex-shrink:0;}
.navigation{padding:0 30rpx;display:flex;align-items:center;gap:18rpx;}
button.nav-history{width:68rpx!important;height:68rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.nav-history image{width:38rpx;height:38rpx;}
.nav-history[disabled]{opacity:.4;}
.brand{display:flex;gap:13rpx;align-items:center;font-size:32rpx;font-weight:650;letter-spacing:0;}
.brand-symbol{width:38rpx;height:38rpx;}
.page-scroll{flex:1;height:0;min-height:0;}
.home{display:flex;flex-direction:column;padding:20rpx 40rpx calc(14rpx + env(safe-area-inset-bottom));max-width:1000rpx;margin:0 auto;}
.hero{flex:1;display:flex;flex-direction:column;justify-content:center;padding:60rpx 8rpx 90rpx;min-height:620rpx;}
.color-orbit{width:156rpx;height:156rpx;position:relative;margin:0 0 45rpx 3rpx;isolation:isolate;}
.orbit-color{position:absolute;width:130rpx;height:130rpx;border-radius:50%;opacity:.65;animation:drift 7s cubic-bezier(.45,0,.55,1) infinite;will-change:transform;}
.orbit-blue{left:-25rpx;top:-15rpx;background:radial-gradient(circle,rgba(66,133,244,.45),rgba(66,133,244,0) 68%);}
.orbit-red{right:-22rpx;top:-15rpx;background:radial-gradient(circle,rgba(234,67,53,.38),rgba(234,67,53,0) 68%);animation-delay:-1.75s;}
.orbit-yellow{right:-24rpx;bottom:-20rpx;background:radial-gradient(circle,rgba(251,188,5,.42),rgba(251,188,5,0) 68%);animation-delay:-3.5s;}
.orbit-green{left:-26rpx;bottom:-20rpx;background:radial-gradient(circle,rgba(52,168,83,.4),rgba(52,168,83,0) 68%);animation-delay:-5.25s;}
.orbit-center{position:absolute;inset:16rpx;background:rgba(255,255,255,.88);border:1rpx solid rgba(255,255,255,.7);border-radius:38rpx;display:flex;align-items:center;justify-content:center;box-shadow:0 5rpx 24rpx rgba(37,67,109,.035);}
.orbit-center image{width:93rpx;height:93rpx;}
@keyframes drift{0%,100%{transform:translate(0,0) scale(.9);}30%{transform:translate(18rpx,-12rpx) scale(1.18);}65%{transform:translate(-12rpx,15rpx) scale(1.08);}}
.hero-eyebrow{display:block;font-size:25rpx;line-height:1.6;color:#6b7280;font-weight:550;margin-bottom:19rpx;}
.hero-title{display:block;font-size:59rpx;line-height:1.48;letter-spacing:-1rpx;font-weight:700;color:#242730;}
.color-text{color:#4285f4;background:linear-gradient(100deg,#4285f4 0%,#4285f4 12%,#ea4335 34%,#d79b00 52%,#34a853 70%,#4285f4 90%,#4285f4 100%);background-size:240% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:color-flow 10s ease-in-out infinite;}
@keyframes color-flow{0%,100%{background-position:0% 50%;}50%{background-position:100% 50%;}}
.hero-description{display:block;font-size:27rpx;line-height:1.8;color:#6b7280;margin-top:25rpx;font-weight:500;}
.composer{border:2rpx solid #edf0f5;border-radius:40rpx;background:#f0f4f9;padding:30rpx 30rpx 22rpx;transition:background .18s ease,border-color .18s ease,box-shadow .18s ease;}
.composer.is-focused{background:#f7f9fc;border-color:#bdd0f6;box-shadow:0 0 0 5rpx rgba(66,133,244,.055);}
.question-input{font-size:31rpx;line-height:1.6;height:60rpx;color:#202124;font-weight:550;margin:0 0 23rpx;}
.input-placeholder{color:#7b8390;font-size:29rpx;font-weight:500;}
.composer-footer{display:flex;align-items:center;justify-content:space-between;gap:18rpx;}
.composer-hint{display:flex;align-items:center;gap:8rpx;font-size:22rpx;color:#747c89;font-weight:500;}
.composer-hint image{width:24rpx;height:24rpx;opacity:.8;}
button.listen-button{width:auto!important;min-width:222rpx;height:84rpx;border-radius:45rpx;background:#0b57d0;color:#fff;display:flex;align-items:center;justify-content:center;gap:15rpx;padding:0 25rpx;font-size:27rpx;font-weight:650;transition:transform .12s ease,background .12s ease;}
.listen-button image{width:32rpx;height:32rpx;}
.listen-button[disabled]{background:#dce7fb;color:#315c9f;}
.home-footer{height:68rpx;display:flex;align-items:center;justify-content:center;font-size:22rpx;color:#838a96;font-weight:500;}
button.cancel-listening{width:auto!important;font-size:24rpx;color:#58709a;padding:15rpx 26rpx;}
.is-listening .orbit-color{animation-duration:1.3s;opacity:1;}
.is-listening .orbit-center{animation:listening 1.3s ease-in-out infinite;}
.is-listening .color-text{animation-duration:2s;}
.is-listening .hero-description{animation:soft-fade .35s ease both;}
@keyframes listening{0%,100%{transform:scale(.92);}50%{transform:scale(1.08);}}
@keyframes soft-fade{from{opacity:.2;}to{opacity:1;}}
.button-spinner{width:27rpx;height:27rpx;border:3rpx solid #b2c9f3;border-top-color:#4285f4;border-right-color:#34a853;border-radius:50%;animation:spin .7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.primary-pressed{background:#0847ae!important;transform:scale(.97);}
.icon-pressed{background:#e9eef6!important;transform:scale(.94);}
.text-pressed{opacity:.55;}
.page-content{padding:38rpx 40rpx calc(35rpx + env(safe-area-inset-bottom));max-width:1000rpx;margin:0 auto;}
.answer-page{animation:enter .32s cubic-bezier(.2,0,0,1) both;}
@keyframes enter{from{opacity:0;transform:translateY(14rpx);}to{opacity:1;transform:translateY(0);}}
.edition-row{display:flex;align-items:center;justify-content:space-between;color:#6f7783;font-size:23rpx;line-height:1.6;}
.edition{display:flex;align-items:center;gap:12rpx;font-weight:600;color:#4d5f7f;}
.color-dot{width:12rpx;height:12rpx;border-radius:50%;background:#4285f4;animation:cycle-color 8s ease-in-out infinite;}
@keyframes cycle-color{0%,100%{background:#4285f4;}25%{background:#ea4335;}50%{background:#fbbc05;}75%{background:#34a853;}}
.date-label{font-size:21rpx;}
.answer-question{margin:40rpx 0 32rpx;padding:27rpx 31rpx;border-radius:27rpx 27rpx 6rpx 27rpx;background:#f0f4f9;color:#5c6573;font-size:28rpx;line-height:1.8;overflow-wrap:anywhere;}
.answer-card{padding:34rpx 6rpx 0;}
.answer-mark{width:61rpx;height:61rpx;margin-bottom:32rpx;}
.answer-text{display:block;font-size:56rpx;line-height:1.55;letter-spacing:0;font-weight:700;color:#202124;overflow-wrap:anywhere;animation:enter .38s cubic-bezier(.2,0,0,1) both;}
.answer-reflection{display:block;font-size:31rpx;font-weight:500;line-height:1.95;color:#636c79;margin-top:32rpx;animation:enter .38s .07s cubic-bezier(.2,0,0,1) both;}
.card-footer{display:flex;justify-content:space-between;align-items:center;border-bottom:1rpx solid #e8ecf1;margin-top:53rpx;padding-bottom:25rpx;color:#7c8591;font-size:23rpx;gap:8rpx;}
.answer-actions{display:flex;gap:5rpx;}
button.card-action{width:72rpx!important;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;transition:transform .12s ease;}
.card-action image{width:35rpx;height:35rpx;}
.saved-hint{display:flex;gap:10rpx;align-items:center;font-size:23rpx;color:#747e8c;margin:30rpx 7rpx 46rpx;line-height:1.8;}
.saved-dot{width:8rpx;height:8rpx;border-radius:50%;background:#34a853;flex-shrink:0;}
button.primary-button{width:100%!important;display:flex;align-items:center;justify-content:center;gap:22rpx;height:100rpx;border-radius:50rpx;background:#0b57d0;color:#fff;font-size:30rpx;font-weight:650;transition:transform .12s ease,background .12s ease;}
.primary-button image{width:35rpx;height:35rpx;}
.save-warning{display:flex;align-items:center;justify-content:space-between;margin:30rpx 0;color:#b3261e;font-size:24rpx;}
.save-warning button{width:auto!important;text-decoration:underline;padding:15rpx;}
.journal-page{animation:enter .24s cubic-bezier(.2,0,0,1) both;}
.journal-heading{margin:35rpx 8rpx 46rpx;}
.journal-title{display:block;font-size:59rpx;font-weight:700;line-height:1.43;letter-spacing:-1rpx;}
.journal-description{display:block;color:#737c89;font-size:27rpx;line-height:1.8;margin-top:23rpx;}
.journal-controls{display:flex;justify-content:space-between;align-items:center;padding:0 4rpx 20rpx;}
.filter-row{display:flex;gap:10rpx;background:#f0f4f9;padding:6rpx;border-radius:33rpx;}
button.filter{width:auto!important;min-width:115rpx;padding:11rpx 22rpx;font-size:25rpx;color:#7b8492;border-radius:27rpx;line-height:1.5;}
.filter text{font-size:21rpx;margin-left:4rpx;}
.filter.selected{color:#234e94;font-weight:650;background:#fff;box-shadow:0 2rpx 5rpx rgba(24,53,98,.04);}
.local-only{display:flex;gap:7rpx;font-size:21rpx;color:#8a929e;align-items:center;}
.local-only image{width:24rpx;height:24rpx;opacity:.7;}
.search-box{display:flex;align-items:center;gap:18rpx;margin:10rpx 0 24rpx;background:#f5f7fa;border-radius:27rpx;padding:22rpx 25rpx;}
.search-box>image{width:30rpx;height:30rpx;}
.search-box input{flex:1;height:40rpx;font-size:27rpx;color:#434d5c;}
.search-box .input-placeholder{font-size:25rpx;}
.entry-list{display:flex;flex-direction:column;gap:18rpx;}
button.entry{display:block;width:100%!important;text-align:left;border:1rpx solid #e9edf3;border-radius:27rpx;padding:26rpx 28rpx;background:#fff;transition:background .12s ease,transform .12s ease;}
.entry-meta{display:flex;align-items:center;justify-content:space-between;font-size:21rpx;color:#929aa6;}
.entry-bookmark{width:28rpx;height:28rpx;}
.entry-arrow{font-size:29rpx;color:#7589ac;}
.entry-question{display:block;color:#717b89;font-size:25rpx;margin-top:19rpx;line-height:1.7;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.entry-answer{display:block;font-size:33rpx;font-weight:650;line-height:1.7;margin-top:10rpx;color:#282e37;}
.entry-note{display:flex;align-items:center;gap:9rpx;color:#6084a8;font-size:22rpx;margin-top:21rpx;}
.tiny-dot{width:7rpx;height:7rpx;background:#6994c2;border-radius:50%;flex-shrink:0;}
.entry-pressed{background:#f3f6fb!important;transform:scale(.988);}
.empty-state{text-align:center;padding:65rpx 0 55rpx;}
.empty-state>image{width:85rpx;height:85rpx;margin:0 auto 34rpx;opacity:.85;}
.empty-title{display:block;color:#4d5969;font-size:31rpx;font-weight:650;line-height:1.65;}
.empty-description{display:block;font-size:25rpx;color:#838d9b;margin-top:19rpx;line-height:1.9;}
button.empty-action{width:auto!important;display:inline-flex;gap:20rpx;font-size:27rpx;color:#0b57d0;margin-top:32rpx;padding:19rpx 28rpx;border-radius:27rpx;background:#edf3ff;}
button.about-link{width:auto!important;margin:0 auto!important;font-size:24rpx;color:#8b95a3;text-align:center;padding:40rpx 20rpx 5rpx;}
.about-link text{margin-left:9rpx;}
.sheet-backdrop{position:fixed;inset:0;background:rgba(29,39,57,.24);z-index:20;display:flex;align-items:flex-end;animation:backdrop-in .22s ease both;}
@keyframes backdrop-in{from{background:rgba(29,39,57,0);}to{background:rgba(29,39,57,.24);}}
.sheet{position:relative;width:100%;max-height:89%;display:flex;flex-direction:column;background:#fff;border-radius:40rpx 40rpx 0 0;padding:20rpx 0 calc(20rpx + env(safe-area-inset-bottom));animation:sheet-in .28s cubic-bezier(.2,0,0,1) both;}
@keyframes sheet-in{from{transform:translateY(70rpx);opacity:.5;}to{transform:translateY(0);opacity:1;}}
.is-closing.sheet-backdrop{animation:backdrop-out .18s ease both;}
.is-closing .sheet{animation:sheet-out .18s cubic-bezier(.4,0,1,1) both;}
@keyframes sheet-out{to{transform:translateY(60rpx);opacity:0;}}
@keyframes backdrop-out{to{background:rgba(29,39,57,0);}}
.sheet-handle{width:64rpx;height:7rpx;border-radius:5rpx;background:#dce1e8;margin:0 auto 30rpx;flex-shrink:0;}
button.sheet-close{position:absolute;right:26rpx;top:29rpx;width:63rpx!important;height:63rpx;border-radius:50%;font-size:43rpx;line-height:57rpx;text-align:center;color:#7d8796;z-index:2;}
.sheet-scroll{height:1120rpx;max-height:73vh;min-height:0;}
.about-content{padding:12rpx 46rpx 20rpx;}
.about-logo{width:76rpx;height:76rpx;margin-top:7rpx;}
.about-title{display:block;font-size:43rpx;font-weight:700;line-height:1.6;margin:30rpx 0;}
.about-copy{display:block;font-size:28rpx;color:#687482;line-height:1.95;margin-bottom:24rpx;}
.about-rule{height:1rpx;background:#e8ecf2;margin:33rpx 0;}
.setting-row{display:flex;align-items:center;justify-content:space-between;}
.setting-title{display:block;font-size:29rpx;color:#3f4b5c;font-weight:600;}
.setting-description{display:block;font-size:24rpx;color:#8b95a3;margin-top:10rpx;}
.privacy-copy{display:flex;align-items:flex-start;gap:12rpx;margin:34rpx 0;color:#8a95a4;font-size:24rpx;line-height:1.9;}
.privacy-copy image{width:27rpx;height:27rpx;flex-shrink:0;margin-top:7rpx;opacity:.7;}
.about-signature{display:block;text-align:center;font-size:25rpx;color:#7284a2;margin:38rpx 0 18rpx;}
.version{display:block;text-align:center;color:#a3adba;font-size:21rpx;}
.detail-content{padding:22rpx 42rpx 0;}
.detail-meta{display:flex;justify-content:space-between;font-size:22rpx;color:#8d98a7;margin:6rpx 55rpx 28rpx 0;}
.detail-question{display:block;font-size:27rpx;color:#758193;line-height:1.8;margin-bottom:25rpx;overflow-wrap:anywhere;}
.detail-answer{display:block;font-size:46rpx;font-weight:700;line-height:1.65;margin-bottom:24rpx;}
.detail-reflection{display:block;font-size:28rpx;color:#687687;line-height:1.9;}
.detail-actions{display:flex;gap:25rpx;border-bottom:1rpx solid #e8edf3;padding:25rpx 0;margin-bottom:31rpx;}
.detail-actions button{width:auto!important;display:flex;align-items:center;gap:12rpx;font-size:25rpx;color:#5e7ead;padding:12rpx 15rpx;border-radius:25rpx;}
.detail-actions image{width:31rpx;height:31rpx;}
.note-title{display:flex;align-items:center;gap:13rpx;font-size:30rpx;color:#384c6d;font-weight:650;}
.note-title image{width:29rpx;height:29rpx;}
.note-subtitle{display:block;font-size:24rpx;color:#8b96a7;margin-top:13rpx;line-height:1.8;}
.note-input{width:100%;height:210rpx;border:1rpx solid #e6ecf5;border-radius:24rpx;margin-top:22rpx;padding:24rpx;color:#455b7b;font-size:28rpx;line-height:1.8;background:#f5f8fc;}
.note-input .input-placeholder{font-size:27rpx;}
.note-counter{display:block;text-align:right;margin:11rpx 5rpx 25rpx;font-size:21rpx;color:#a3afbf;}
button.delete-entry{width:auto!important;margin:0 auto!important;display:block;text-align:center;font-size:24rpx;color:#9b8e8c;padding:30rpx 0 18rpx;}
@media (max-height:700px){.hero{padding-top:28rpx;padding-bottom:38rpx;min-height:460rpx;}.color-orbit{width:122rpx;height:122rpx;margin-bottom:28rpx;}.orbit-color{width:110rpx;height:110rpx;}.orbit-center{inset:12rpx;border-radius:30rpx;}.orbit-center image{width:76rpx;height:76rpx;}.hero-title{font-size:54rpx;}.hero-description{margin-top:17rpx;}.hero-eyebrow{margin-bottom:12rpx;font-size:23rpx;}.composer{padding:22rpx 25rpx 18rpx;}.question-input{margin-bottom:15rpx;}.home-footer{height:59rpx;}}
@media (prefers-reduced-motion:reduce){.orbit-color,.orbit-center,.color-text,.color-dot,.button-spinner,.answer-page,.answer-text,.answer-reflection,.journal-page,.sheet,.sheet-backdrop{animation:none!important;}.listen-button,.primary-button,.composer,.entry{transition:none!important;}}

/* 2.01 — reading rhythm and unified motion */
.navigation{gap:16rpx;padding:0 32rpx;}
button.nav-history{background:#f3f6fa;width:70rpx!important;height:70rpx;transition:background .16s ease,transform .16s ease;}
.nav-history image{width:35rpx;height:35rpx;}
