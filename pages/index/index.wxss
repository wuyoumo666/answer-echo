.question-input .input-placeholder{font-size:29rpx;color:#8190a5;line-height:1.75;}
.composer-footer{border-top:1rpx solid #e9eef6;padding-top:21rpx;}
.composer-hint{font-size:21rpx;color:#7b8da7;}
.composer-hint image{width:23rpx;height:23rpx;opacity:.7;}
button.listen-button{min-width:235rpx;height:90rpx;min-height:44px;padding:0 22rpx 0 27rpx;gap:13rpx;background:linear-gradient(125deg,#286ee4,#0b57d0 65%,#1553c1);box-shadow:0 6rpx 16rpx rgba(11,87,208,.16);}
.listen-arrow{width:38rpx;height:38rpx;border-radius:50%;background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;}
