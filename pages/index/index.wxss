/* 2.02 · Listen to yourself, revisit the outcome, keep a letter for later. */
.section-eyebrow{display:block;font-size:21rpx;letter-spacing:2rpx;color:#6a83a7;font-weight:600;line-height:1.7;}
.journey-content{padding:16rpx 42rpx 30rpx;}
.journey-title{display:block;font-size:43rpx;line-height:1.55;letter-spacing:-.3rpx;font-weight:700;color:#2c3c53;margin:18rpx 48rpx 18rpx 0;}
.journey-title .color-text{display:block;}
.journey-description{display:block;font-size:25rpx;line-height:1.9;color:#77879d;margin-bottom:30rpx;}
.gentle-caption{display:block;font-size:23rpx;line-height:1.85;color:#8795a9;margin-top:18rpx;overflow-wrap:anywhere;}
.intuition-sheet .sheet-scroll{height:auto;}
.intuition-choices{display:flex;flex-direction:column;gap:15rpx;margin:30rpx 0;}
button.intuition-choice{display:flex;align-items:center;justify-content:space-between;width:100%!important;min-height:46px;border:1rpx solid #e2e9f3;border-radius:24rpx;padding:21rpx 27rpx;color:#637792;font-size:29rpx;background:#f8fafc;}
.intuition-choice.selected{background:#eff5ff;border-color:#a8c4ee;color:#275998;font-weight:600;}
.intuition-choice text:last-child{color:#8ca8cf;}
button.journey-skip{display:block;width:100%!important;min-height:44px;padding:22rpx 8rpx 8rpx;text-align:center;font-size:25rpx;color:#8290a3;}
.intuition-content>.gentle-caption{text-align:center;font-size:21rpx;}
.self-listening{border-top:1rpx solid #e5ebf3;margin:24rpx 0 14rpx;padding:28rpx 5rpx 14rpx;}
.intuition-memory{display:block;font-size:24rpx;color:#8191a7;margin-top:10rpx;line-height:1.85;}
.self-question{display:block;font-size:29rpx;line-height:1.8;color:#435772;font-weight:600;margin:16rpx 0 19rpx;}
.choice-row{display:flex;flex-wrap:wrap;gap:15rpx;}
button.choice-pill{display:flex;align-items:center;justify-content:center;min-height:44px;width:auto!important;padding:15rpx 25rpx;border:1rpx solid #dfe7f2;border-radius:24rpx;color:#7688a2;background:#fbfcfe;font-size:25rpx;line-height:1.65;}
.choice-pill.selected{background:#edf5ff;border-color:#aac4e7;color:#2d639d;font-weight:600;}
button.future-link{display:flex;justify-content:center;align-items:center;gap:20rpx;min-height:44px;width:100%!important;margin:12rpx 0 24rpx!important;font-size:24rpx;line-height:1.8;color:#7a8eae;}
button.future-inbox{display:flex;align-items:center;width:100%!important;border:1rpx solid #e3eaf5;border-radius:26rpx;padding:22rpx 23rpx;margin:0 0 27rpx!important;background:linear-gradient(115deg,#f3f7ff,#fdf9f7);text-align:left;gap:18rpx;}
.future-inbox-mark{font-size:38rpx;width:61rpx;height:65rpx;display:flex;align-items:center;justify-content:center;color:#7497c9;border-radius:19rpx;background:#fff;flex-shrink:0;}
.future-inbox-copy{flex:1;min-width:0;}
.future-inbox-copy>text{display:block;font-size:27rpx;font-weight:600;line-height:1.7;color:#526d92;}
.future-inbox-copy>.future-inbox-caption{font-size:21rpx;color:#8d9bae;font-weight:500;margin-top:5rpx;}
.future-inbox-arrow{font-size:27rpx;color:#7d94b8;}
.detail-intuition{display:block;font-size:23rpx;color:#8293ab;line-height:1.8;margin-bottom:23rpx;}
.detail-actions{gap:5rpx;flex-wrap:wrap;}
.detail-actions button{min-height:44px;}
.later-section{padding-bottom:31rpx;margin-bottom:30rpx;border-bottom:1rpx solid #e8edf3;}
.outcome-choices{display:flex;flex-wrap:wrap;gap:12rpx;}
.outcome-choices .choice-pill{font-size:24rpx;padding:14rpx 21rpx;}
.outcome-badge{color:#628f7d;}
.outcome-badge .tiny-dot{background:#74a68f;}
.note-input{height:240rpx;line-height:1.85;}
.capsule-list{display:flex;flex-direction:column;gap:18rpx;}
.capsule-row{display:flex;align-items:center;border:1rpx solid #e4eaf3;background:linear-gradient(140deg,#f8faff,#fff);border-radius:27rpx;overflow:hidden;}
.capsule-row.capsule-ready{background:linear-gradient(140deg,#f1f8f5,#fff);border-color:#d7e9df;}
button.capsule-open{flex:1;min-width:0;width:0!important;display:flex;align-items:center;gap:20rpx;padding:25rpx 0 25rpx 24rpx;text-align:left;}
.capsule-envelope{font-size:44rpx;color:#8fa5c6;flex-shrink:0;}
.capsule-summary{flex:1;min-width:0;}
.capsule-summary>text{display:block;line-height:1.8;}
.capsule-date{font-size:30rpx;font-weight:650;color:#4c617f;}
.capsule-status{font-size:23rpx;color:#8b9bb1;}
.capsule-ready .capsule-status{color:#5b927a;}
.capsule-created{font-size:20rpx;color:#a1acbc;margin-top:8rpx;}
.capsule-arrow{font-size:27rpx;color:#8ba2c3;}
button.capsule-remove{display:flex;align-items:center;justify-content:center;width:44px!important;min-height:44px;align-self:stretch;font-size:33rpx;color:#a8b2c0;}
.capsule-empty{padding:55rpx 0 65rpx;text-align:center;color:#6c819f;font-size:30rpx;}
.capsule-footnote{margin-top:28rpx;font-size:21rpx;}
button.capsule-back{width:auto!important;min-height:44px;display:flex;align-items:center;color:#7b90af;font-size:24rpx;margin-bottom:18rpx!important;}
.future-message{padding:26rpx;background:linear-gradient(135deg,#f1f6ff,#fdf7f5);border-radius:26rpx;margin:28rpx 0;color:#536c8e;font-size:29rpx;line-height:1.9;white-space:pre-wrap;overflow-wrap:anywhere;}
.future-message .section-eyebrow{font-size:20rpx;margin-bottom:15rpx;}
.capsule-answer{font-size:43rpx;overflow-wrap:anywhere;}
.seal-backdrop{position:fixed;top:0;left:0;right:0;z-index:35;display:flex;align-items:flex-end;background:rgba(31,45,69,.27);}
.seal-panel{position:relative;width:100%;max-height:94%;padding-top:20rpx;padding-bottom:calc(22rpx + env(safe-area-inset-bottom));border-radius:36rpx 36rpx 0 0;background:#fff;animation:motion-sheet-in .3s cubic-bezier(.22,1,.36,1) both;}
.seal-panel .sheet-handle{margin-bottom:24rpx;}
.seal-scroll{height:1100rpx;min-height:0;}
.seal-answer{display:block;font-size:26rpx;font-weight:600;line-height:1.85;padding:22rpx 26rpx;background:#f5f8fd;color:#6b819f;border-radius:22rpx;margin:24rpx 0;overflow-wrap:anywhere;}
.field-label{display:block;font-size:25rpx;color:#607798;font-weight:600;margin:23rpx 0 14rpx;}
.field-optional{font-size:21rpx;color:#9aa6b7;font-weight:500;margin-left:10rpx;}
.seal-date{display:flex;align-items:center;justify-content:space-between;min-height:44px;padding:21rpx 25rpx;border:1rpx solid #dce6f3;border-radius:22rpx;font-size:28rpx;color:#4a709e;background:#f9fbff;}
.seal-date>text:last-child{font-size:22rpx;color:#8ca1bf;}
.seal-message{width:100%;height:190rpx;padding:22rpx 24rpx;font-size:28rpx;line-height:1.85;background:#f5f8fc;border:1rpx solid #e3eaf4;border-radius:22rpx;color:#506784;}
.seal-message .input-placeholder{font-size:26rpx;color:#96a3b5;}
.seal-explanation{font-size:21rpx;text-align:center;}
.seal-reminder{margin:22rpx 0 28rpx;padding:20rpx 24rpx;background:#f6f8fc;border-radius:22rpx;}
.seal-reminder-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:26rpx;color:#536e93;font-weight:600;}
.seal-reminder-caption{display:block;margin-top:12rpx;font-size:21rpx;line-height:1.8;color:#8492a7;}
.capsule-reminder{display:flex;align-items:center;justify-content:space-between;padding:0 18rpx;font-size:21rpx;color:#8296b2;}
button.reminder-retry{width:auto!important;min-height:44px;font-size:22rpx;color:#6689bb;}
.is-inactive .echo-wash,.is-keyboard .echo-wash{animation-play-state:paused;}
.is-keyboard .note-input{height:180rpx;}
.is-keyboard .seal-message{height:160rpx;}
button.nav-history,button.card-action,button.sheet-close,button.image-share-close{min-width:44px;min-height:44px;}
button.nav-history.nav-home{width:auto!important;min-width:76px;padding:0 16rpx;gap:8rpx;border-radius:40rpx;color:#526d92;font-size:26rpx;font-weight:600;}
.nav-home image{width:30rpx;height:30rpx;}
.detail-answer,.detail-reflection,.answer-reflection{overflow-wrap:anywhere;}
@media(max-height:700px){.journey-content{padding:7rpx 34rpx 25rpx;}.journey-title{font-size:38rpx;margin-top:13rpx;}.journey-description{font-size:24rpx;margin-bottom:22rpx;}.intuition-choices{gap:11rpx;margin:20rpx 0;}.intuition-choice{padding:16rpx 23rpx!important;}.intuition-content .gentle-caption{font-size:20rpx;}.future-inbox-copy>.future-inbox-caption{font-size:20rpx;}}
@media(prefers-reduced-motion:reduce){.seal-panel{animation:none!important;}}
