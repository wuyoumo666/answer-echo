.about-copy{font-size:27rpx;line-height:1.95;color:#7b8aa0;}
.detail-meta{font-size:21rpx;color:#98a5b8;}
.detail-question{font-size:26rpx;line-height:1.9;color:#8594aa;margin-bottom:24rpx;}
.detail-answer{font-size:44rpx;font-weight:650;line-height:1.7;color:#34435b;word-break:normal;line-break:strict;}
.detail-reflection{font-size:27rpx;line-height:1.95;color:#8291a7;}
.detail-actions{padding:18rpx 0;margin-bottom:28rpx;}
.note-title{font-size:28rpx;font-weight:600;}
.note-subtitle{font-size:23rpx;line-height:1.9;color:#98a6ba;}
.note-input{border-radius:22rpx;font-size:27rpx;line-height:1.9;padding:22rpx;background:#f7f9fd;}
.note-counter{font-size:20rpx;}
.notice{position:fixed;z-index:40;left:50%;transform:translateX(-50%);max-width:88%;padding:20rpx 28rpx;display:flex;align-items:center;gap:13rpx;background:#f2f7ff;border:1rpx solid #dbe7f9;border-radius:25rpx;box-shadow:0 8rpx 28rpx rgba(34,70,124,.07);color:#5d7fae;font-size:24rpx;line-height:1.6;white-space:nowrap;pointer-events:none;animation:notice-in .24s cubic-bezier(.22,1,.36,1) both;}
.notice-symbol{font-weight:700;font-size:25rpx;}
.notice.notice-error{background:#fff6f4;border-color:#f0dcd7;color:#b37669;}
.notice.notice-closing{animation:notice-out .18s ease both;}
@keyframes notice-in{from{opacity:0;transform:translate(-50%,-12rpx) scale(.97);}to{opacity:1;transform:translate(-50%,0) scale(1);}}
@keyframes notice-out{to{opacity:0;transform:translate(-50%,-8rpx) scale(.98);}}
@media(max-height:700px){.hero{min-height:405rpx;padding-top:18rpx;padding-bottom:28rpx;}.color-orbit{width:108rpx;height:108rpx;margin-bottom:22rpx;}.orbit-center{border-radius:26rpx;inset:11rpx;}.orbit-center image{width:68rpx;height:68rpx;}.orbit-color{width:95rpx;height:95rpx;}.hero-title{font-size:49rpx;}.hero-eyebrow{font-size:22rpx;margin-bottom:11rpx;}.hero-description{margin-top:15rpx;font-size:24rpx;}.composer{padding:21rpx 24rpx;}.composer-label{margin-bottom:14rpx;}.question-input{margin-bottom:18rpx;min-height:55rpx;}.home.is-typing .hero{min-height:200rpx;}}
@media(min-width:600px){.home,.page-content{padding-left:24px;padding-right:24px;}.hero-title,.journal-title{font-size:34px;}.hero-description,.journal-description{font-size:16px;}.hero{min-height:360px;}.composer{padding:24px;}.question-input{font-size:18px;}.question-input .input-placeholder{font-size:17px;}}
@media(prefers-reduced-motion:reduce){.scene,.sheet,.sheet-backdrop,.entry-animated,.notice,.notice.notice-closing,.is-closing .sheet,.is-closing.sheet-backdrop{animation:none!important;}.scene,.filter-slider,.entry-list,.nav-history{transition:none!important;}}
.brand text{display:block;color:#28364b;-webkit-text-fill-color:#28364b;white-space:nowrap;flex-shrink:0;}

.answer-text,.detail-answer{white-space:pre-line;}

/* Approved motion: soft reveal, direct navigation, restrained sheet. */
.brand-emblem{width:138rpx;height:138rpx;margin:0 0 38rpx;display:flex;align-items:center;justify-content:center;}
.brand-emblem image{width:126rpx;height:126rpx;}
.home.is-typing .brand-emblem{display:none;}
.color-text{animation:none;background-size:100% 100%;background-position:0 50%;}
.color-dot{animation:none;background:#4285f4;}
.is-listening .hero-description{animation:motion-fade-in .18s ease both;}
.button-spinner{border-color:#bdd0ec;border-top-color:#547bb4;border-right-color:#bdd0ec;}
.scene{animation:motion-page-in .28s cubic-bezier(.16,1,.3,1) both;transition:opacity .11s ease;transform:none;}
.scene.scene-leaving,.scene.scene-back.scene-leaving{animation:none;opacity:0;transform:none;pointer-events:none;}
.scene.motion-reveal{animation:motion-fade-in .2s ease both;}
.motion-reveal .answer-card{animation:motion-soft-card .44s cubic-bezier(.22,1,.36,1) both;transform-origin:50% 60%;}
.motion-reveal .answer-text{animation:motion-copy-in .28s .08s cubic-bezier(.22,1,.36,1) both;}
.motion-reveal .answer-reflection{animation:motion-fade-in .25s .12s ease both;}
.motion-reveal .saved-hint,.motion-reveal .save-warning,.motion-reveal .again-button{animation:motion-copy-in .28s .14s cubic-bezier(.22,1,.36,1) both;}
.scene.motion-return{animation:motion-page-in .32s cubic-bezier(.22,1,.36,1) both;}
.entry-animated{animation:motion-record-in .25s cubic-bezier(.16,1,.3,1) backwards;}
.sheet-backdrop{animation:motion-overlay-in .28s ease both;}
.sheet{animation:motion-sheet-in .38s cubic-bezier(.22,1,.36,1) both;transform-origin:50% 100%;}
.detail-content,.about-content{animation:motion-copy-in .26s .06s cubic-bezier(.22,1,.36,1) both;}
.is-closing .sheet{animation:motion-sheet-out .23s cubic-bezier(.4,0,1,1) both;pointer-events:none;}
.is-closing.sheet-backdrop{animation:motion-overlay-out .23s ease both;}
.notice{animation:motion-notice-in .18s cubic-bezier(.22,1,.36,1) both;}
.notice.notice-closing{animation:motion-notice-out .18s ease both;}
@keyframes motion-fade-in{from{opacity:0;}to{opacity:1;}}
@keyframes motion-page-in{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}
@keyframes motion-soft-card{from{opacity:0;transform:translateY(12px) scale(.98);}to{opacity:1;transform:translateY(0) scale(1);}}
@keyframes motion-copy-in{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}
@keyframes motion-record-in{from{opacity:0;transform:translateY(3px);}to{opacity:1;transform:translateY(0);}}
@keyframes motion-overlay-in{from{background:rgba(31,45,69,0);}to{background:rgba(31,45,69,.27);}}
@keyframes motion-overlay-out{from{background:rgba(31,45,69,.27);}to{background:rgba(31,45,69,0);}}
@keyframes motion-sheet-in{from{opacity:0;transform:translateY(24px) scale(.99);}to{opacity:1;transform:translateY(0) scale(1);}}
@keyframes motion-sheet-out{from{opacity:1;transform:translateY(0);}to{opacity:0;transform:translateY(24px);}}
@keyframes motion-notice-in{from{opacity:0;transform:translate(-50%,-4px);}to{opacity:1;transform:translate(-50%,0);}}
@keyframes motion-notice-out{from{opacity:1;transform:translate(-50%,0);}to{opacity:0;transform:translate(-50%,-3px);}}
@media(max-height:700px){.brand-emblem{width:108rpx;height:108rpx;margin-bottom:22rpx;}.brand-emblem image{width:100rpx;height:100rpx;}}

/* A single logo turn bridges the question and the answer. */
.hero,.composer{transition:opacity .15s ease,transform .2s cubic-bezier(.22,1,.36,1);}
.home.is-listening .hero,.home.is-listening .composer,.home.is-listening .home-footer{opacity:0;pointer-events:none;}
.home.is-listening .hero,.home.is-listening .composer{transform:translateY(-4px);}
.brand-transition{position:absolute;left:0;right:0;bottom:0;z-index:15;background:#fff;display:flex;align-items:center;justify-content:center;animation:brand-stage-in .16s ease both;}
.brand-transition-content{display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 48rpx 100rpx;}
.brand-transition-mark{width:184rpx;height:184rpx;margin-bottom:40rpx;animation:brand-mark-in .24s cubic-bezier(.22,1,.36,1) both;}
.brand-transition-symbol{width:100%;height:100%;animation:brand-turn .9s cubic-bezier(.4,0,.18,1) both;transform-origin:50% 50%;}
.brand-transition-title{display:block;color:#53647e;font-size:30rpx;font-weight:600;letter-spacing:2rpx;animation:motion-copy-in .25s .08s cubic-bezier(.22,1,.36,1) both;}
.brand-transition-caption{display:block;color:#99a4b4;font-size:24rpx;font-weight:500;line-height:1.8;margin-top:17rpx;animation:motion-fade-in .25s .13s ease both;}
button.brand-transition-cancel{position:absolute;bottom:calc(38rpx + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);width:auto!important;min-height:44px;padding:16rpx 32rpx;border-radius:30rpx;color:#8e9bae;font-size:24rpx;}
.brand-transition-cancel[disabled]{opacity:0;pointer-events:none;}
.brand-transition.brand-transition-closing{animation:brand-stage-out .2s ease both;pointer-events:none;}
@keyframes brand-stage-in{from{opacity:0;}to{opacity:1;}}
@keyframes brand-stage-out{from{opacity:1;}to{opacity:0;}}
@keyframes brand-mark-in{from{opacity:0;transform:scale(.9);}to{opacity:1;transform:scale(1);}}
@keyframes brand-turn{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
@media(max-height:700px){.brand-transition-mark{width:166rpx;height:166rpx;margin-bottom:32rpx;}.brand-transition-content{padding-bottom:70rpx;}}
@media(prefers-reduced-motion:reduce){.brand-transition,.brand-transition.brand-transition-closing,.brand-transition-mark,.brand-transition-symbol,.brand-transition-title,.brand-transition-caption{animation:none!important;}.hero,.composer{transition:none!important;}}
@media(prefers-reduced-motion:reduce){.scene,.scene.motion-reveal,.scene.motion-return,.motion-reveal .answer-card,.motion-reveal .answer-text,.motion-reveal .answer-reflection,.motion-reveal .saved-hint,.motion-reveal .save-warning,.motion-reveal .again-button,.entry-animated,.sheet,.sheet-backdrop,.detail-content,.about-content,.is-closing .sheet,.is-closing.sheet-backdrop,.notice,.notice.notice-closing,.is-listening .hero-description{animation:none!important;}.scene{transition:none!important;}}

/* 局部浅彩光晕：独立慢速路径与呼吸错开，保留大面积留白。 */
.echo-background{position:absolute;top:0;right:0;bottom:0;left:0;overflow:hidden;pointer-events:none;background:#fcfdff;z-index:0;}
.echo-wash{position:absolute;width:76vw;height:76vw;max-width:380px;max-height:380px;transform-origin:50% 50%;animation-timing-function:ease-in-out;animation-iteration-count:infinite;}
.echo-wash-cool{left:-24vw;top:2vh;background:radial-gradient(ellipse at center,rgba(104,156,247,.32) 0%,rgba(104,156,247,.15) 30%,rgba(104,156,247,0) 70%);animation-name:echo-drift-cool;animation-duration:29s;animation-delay:-7s;}
.echo-wash-warm{left:55vw;top:32vh;background:radial-gradient(ellipse at center,rgba(239,151,175,.29) 0%,rgba(239,151,175,.13) 30%,rgba(239,151,175,0) 70%);animation-name:echo-drift-warm;animation-duration:37s;animation-delay:-19s;}
.echo-wash-mint{left:-21vw;top:65vh;background:radial-gradient(ellipse at center,rgba(123,198,163,.30) 0%,rgba(123,198,163,.14) 30%,rgba(123,198,163,0) 70%);animation-name:echo-drift-mint;animation-duration:41s;animation-delay:-11s;}
.echo-wash-amber{left:50vw;top:80vh;background:radial-gradient(ellipse at center,rgba(243,202,120,.33) 0%,rgba(243,202,120,.15) 30%,rgba(243,202,120,0) 70%);animation-name:echo-drift-amber;animation-duration:31s;animation-delay:-23s;}
@keyframes echo-drift-cool{0%,100%{opacity:.72;transform:translate(0,0) scale(.94);}34%{opacity:.94;transform:translate(31vw,15vh) scale(1.08);}69%{opacity:.76;transform:translate(6vw,35vh) scale(1);}}
@keyframes echo-drift-warm{0%,100%{opacity:.76;transform:translate(0,0) scale(1);}38%{opacity:.95;transform:translate(-25vw,-24vh) scale(1.08);}72%{opacity:.7;transform:translate(-38vw,13vh) scale(.94);}}
@keyframes echo-drift-mint{0%,100%{opacity:.74;transform:translate(0,0) scale(1.04);}32%{opacity:.94;transform:translate(29vw,-21vh) scale(.96);}71%{opacity:.76;transform:translate(47vw,4vh) scale(1.08);}}
@keyframes echo-drift-amber{0%,100%{opacity:.7;transform:translate(0,0) scale(.96);}43%{opacity:.92;transform:translate(-24vw,-22vh) scale(1.08);}76%{opacity:.78;transform:translate(-4vw,-43vh) scale(1);}}
@media(prefers-reduced-motion:reduce){.echo-wash{animation:none;opacity:.8;transform:none;}}

/* Accepted breathing background */
.app-shell{background:#fcfdff;}
.status-space,.navigation,.page-scroll{position:relative;z-index:1;}
.composer{background:rgba(255,255,255,.78);}
.composer.is-focused{background:rgba(255,255,255,.94);}
button.nav-history{background:rgba(255,255,255,.72);}
.brand-transition{background:rgba(252,253,255,.9);}
.brand-emblem image,.brand-symbol,.brand-transition-symbol{mix-blend-mode:multiply;}
.brand-emblem{border-radius:32rpx;background:rgba(255,255,255,.78);overflow:hidden;}
.brand-emblem image{border-radius:28rpx;}

/* A quiet writing surface, edged with the brand's four colors. */
.composer-frame{padding:1px;border-radius:35rpx;background:linear-gradient(115deg,rgba(66,133,244,.33),rgba(234,111,133,.23) 38%,rgba(228,184,90,.24) 69%,rgba(82,170,133,.28));box-shadow:0 13rpx 40rpx rgba(44,72,118,.065);transition:box-shadow .22s ease,opacity .15s ease;}
.composer-frame.is-focused{box-shadow:0 15rpx 42rpx rgba(51,95,164,.1),0 0 0 5rpx rgba(98,144,211,.045);}
.composer-frame .composer{padding:26rpx 28rpx 24rpx;border:0;border-radius:33rpx;background:linear-gradient(145deg,rgba(255,255,255,.98),rgba(255,255,255,.91));box-shadow:none;}
.composer-frame .composer.is-focused{background:rgba(255,255,255,.98);box-shadow:none;}
.composer-heading{display:flex;align-items:center;gap:10rpx;}
.composer-heading image{width:25rpx;height:25rpx;opacity:.68;}
.composer-label{margin-bottom:19rpx;letter-spacing:.8rpx;color:#607594;}
.composer-optional{padding:5rpx 12rpx;border-radius:12rpx;background:#f3f6fa;font-size:19rpx;letter-spacing:0;color:#8e9caf;}
.question-field{position:relative;padding-left:32rpx;}
.question-quote{position:absolute;left:0;top:-6rpx;font-size:59rpx;line-height:1;color:#b6c8e4;font-weight:500;transition:color .2s ease;}
.is-focused .question-quote{color:#88a8d8;}
