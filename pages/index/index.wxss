.home.is-listening .composer-frame{opacity:0;pointer-events:none;}
@media(max-height:700px){.composer-frame .composer{padding:21rpx 24rpx 20rpx;}.composer-label{margin-bottom:16rpx;}.question-field .question-input{min-height:72rpx;margin-bottom:17rpx;}.composer-footer{padding-top:17rpx;}}
