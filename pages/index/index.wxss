.composer.is-focused{border-color:#adc5ed;box-shadow:0 12rpx 38rpx rgba(66,112,188,.07),0 0 0 4rpx rgba(66,133,244,.045);}
.composer-label{display:flex;justify-content:space-between;align-items:center;font-size:22rpx;color:#60769b;font-weight:600;margin:0 0 19rpx;letter-spacing:1rpx;}
