page{height:100%;background:#fff;color:#202124;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;font-weight:500;}
view,text,button,input,textarea,scroll-view{box-sizing:border-box;}
button{padding:0;margin:0!important;border-radius:0;font-size:inherit;font-weight:inherit;line-height:inherit;background:none;color:inherit;}
button::after{border:none;}
button[disabled]{color:inherit;}
image{display:block;}
